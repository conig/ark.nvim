{
  "schema_version": 1,
  "defaults": {
    "tier": "serial-integration",
    "layer": "product-e2e",
    "owner": "ark.nvim",
    "contract": "Neovim plugin, LSP, or managed-session integration behavior",
    "serial": true,
    "init": "NONE",
    "open_r_buffer": false,
    "dependencies": ["neovim", "r", "tmux"],
    "typical_runtime": "under 120 seconds",
    "flake_policy": "no automatic pass-on-retry; retain artifacts and classify failures",
    "mutates_shared_session": true
  },
  "exclude": {
    "ark_test.lua": "shared E2E support module",
    "perf.lua": "shared structured performance sample helper",
    "init.lua": "prepared Blink-backed Neovim fixture",
    "tui_blink_trace.lua": "interactive trace probe",
    "tui_startup_chatter_trace.lua": "interactive trace probe",
    "tui_startup_keyword_completion_probe.lua": "interactive trace probe",
    "startup_timing_probe.lua": "interactive benchmark probe invoked by a driver",
    "full_config_typed_completion_timing.lua": "interactive benchmark probe invoked by a driver"
  },
  "rules": [
    {
      "names": ["nvim_console_target_completion.lua"],
      "contract": "project-scoped target completion in a standalone console without evaluating a slow manifest",
      "dependencies": ["neovim", "r", "tmux", "R:targets"],
      "mutates_shared_session": false
    },
    {
      "names": ["ark_view_value_picker_lifecycle.lua"],
      "tier": "fast",
      "layer": "component",
      "contract": "real Snacks live finder handles synchronous backend failures without hanging",
      "dependencies": ["neovim", "snacks"],
      "mutates_shared_session": false
    },
    {
      "names": [
        "ark_view_values_responsiveness.lua",
        "ark_view_values_popup_async.lua"
      ],
      "contract": "nonblocking, bounded exact-value filtering and live search over the full maps city-name column, including popup RPC",
      "dependencies": [
        "neovim",
        "r",
        "tmux",
        "snacks",
        "R:maps",
        "R:data.table"
      ]
    },
    {
      "names": [
        "ark_view_values_bridge.lua"
      ],
      "tier": "fast",
      "layer": "component",
      "contract": "bounded value enumeration, linear grouping, cache invalidation, display/key parity and metadata-only timings",
      "dependencies": [
        "neovim",
        "r",
        "R:jsonlite",
        "R:maps",
        "R:data.table"
      ],
      "mutates_shared_session": false
    },
    {
      "names": ["ark_view_value_search.lua"],
      "contract": "real Snacks value picker searches cell contents without row indices or frequency counts",
      "dependencies": ["neovim", "r", "tmux", "snacks"]
    },
    {
      "names": ["target_interaction_completion.lua"],
      "tier": "fast",
      "layer": "product-e2e",
      "contract": "target-name completion in empty and nested target selections without a live R session",
      "dependencies": ["neovim"],
      "typical_runtime": "under 20 seconds",
      "mutates_shared_session": false
    },
    {
      "names": ["source_install_reconciliation.lua"],
      "tier": "fast",
      "layer": "product-e2e",
      "contract": "normal source install upgrades the selected profile and verifies the running LSP identity",
      "dependencies": ["neovim", "python", "release-binary"],
      "typical_runtime": "under 20 seconds",
      "mutates_shared_session": false
    },
    {
      "names": [
        "blink_extractor_provider_policy.lua",
        "blink_hidden_trigger_context_resets_on_keyword.lua",
        "config_validation.lua",
        "dev_source_boundary.lua",
        "installation_origin_safety.lua",
        "source_update_failure.lua",
        "dev_source_scan_without_rg.lua",
        "error_taxonomy.lua",
        "help_render_pure.lua",
        "lsp_content_modified_retry.lua",
        "lsp_inflight_bootstrap_deduplicates_session_update.lua",
        "lsp_recovers_from_unexpected_exit.lua",
        "notifications_once.lua",
        "product_state_model.lua",
        "report_redaction.lua",
        "status_redacts_auth.lua",
        "startup_state_model.lua",
        "view_layout_policy.lua"
      ],
      "tier": "unit",
      "layer": "pure-unit",
      "contract": "pure Lua rendering or state-transition behavior",
      "dependencies": ["neovim"],
      "typical_runtime": "under 2 seconds",
      "mutates_shared_session": false
    },
    {
      "names": ["large_file_edit_diagnostics_timing.lua"],
      "tier": "performance",
      "layer": "performance",
      "contract": "large-document edit-to-diagnostics latency budget",
      "dependencies": ["neovim"],
      "serial": true,
      "typical_runtime": "under 30 seconds",
      "flake_policy": "fail only beyond the configurable 2000 ms guardrail",
      "mutates_shared_session": false
    },
    {
      "names": [
        "ark_view_cursor_movement_responsiveness.lua",
        "current_env_completion_timing.lua",
        "r_entrypoint_rpc_latency.lua",
        "startup_latency_budget.lua"
      ],
      "tier": "performance",
      "layer": "performance",
      "contract": "versioned user-visible latency budget",
      "dependencies": ["neovim", "r", "tmux"],
      "serial": true,
      "typical_runtime": "under 120 seconds per sample batch",
      "flake_policy": "collect repeated samples; fail malformed data or budget regression",
      "mutates_shared_session": true
    },
    {
      "names": ["detached_process_leak.lua"],
      "tier": "soak",
      "layer": "soak",
      "contract": "detached process lifetime and leak behavior under repetition",
      "dependencies": ["neovim", "r", "tmux"],
      "serial": true,
      "typical_runtime": "over 120 seconds",
      "mutates_shared_session": true
    },
    {
      "globs": ["full_config_*.lua", "*_tui.lua"],
      "tier": "full-tui",
      "layer": "product-e2e",
      "contract": "visible editor behavior with Blink and the prepared full-config fixture",
      "init": "tests/e2e/init.lua",
      "open_r_buffer": true,
      "dependencies": ["neovim", "r", "tmux", "blink"],
      "serial": true
    },
    {
      "content_contains": "blink.cmp is required for this test",
      "tier": "full-tui",
      "layer": "product-e2e",
      "contract": "visible Blink completion or TUI behavior",
      "init": "tests/e2e/init.lua",
      "open_r_buffer": true,
      "dependencies": ["neovim", "r", "tmux", "blink"],
      "serial": true
    },
    {
      "names": [
        "ark_dispatch_command.lua",
        "ark_console_init_plugin_fallback.lua",
        "ark_console_init_user_config.lua",
        "ark_view_popup_routing.lua",
        "detached_parity.lua",
        "health.lua",
        "health_degraded_scenarios.lua",
        "health_inotify_tools.lua",
        "lsp_info_log_redaction.lua",
        "lsp_sync_start_bootstrap.lua",
        "lsp_sync_start_pending_client.lua",
        "native_help.lua",
        "nvim_console_history_store.lua",
        "nvim_console_long_session_rpc.lua",
        "nvim_console_mouse_wheel.lua",
        "nvim_console_stale_rpc_status.lua",
        "release_manifest_and_discovery.lua",
        "report_command.lua",
        "targets_commands.lua",
        "targets_project_store.lua",
        "unterminated_string_diagnostic.lua",
        "workspace_folder_changes.lua",
        "workspace_indexing_background.lua"
      ],
      "tier": "fast",
      "layer": "component",
      "contract": "deterministic routine product confidence",
      "dependencies": ["neovim"],
      "serial": true,
      "typical_runtime": "under 30 seconds",
      "mutates_shared_session": false
    }
  ],
  "overrides": {
    "nvim_console_mouse_wheel.lua": {
      "dependencies": ["neovim", "python"]
    },
    "ark_view_sticky_header_tui.lua": {
      "open_r_buffer": false
    },
    "ark_view_cursor_movement_responsiveness.lua": {
      "dependencies": ["neovim"],
      "mutates_shared_session": false
    },
    "r_entrypoint_rpc_latency.lua": {
      "dependencies": ["neovim"],
      "mutates_shared_session": false
    },
    "detached_parity.lua": {
      "dependencies": ["neovim", "r", "tmux"],
      "mutates_shared_session": true
    },
    "bridge_runtime_rebuild_recovers_startup_tui.lua": {
      "open_r_buffer": false
    },
    "full_config_argument_value_replaces_stale_arg_menu_tui.lua": {
      "open_r_buffer": false
    },
    "full_config_extractor_rapid_select_tui.lua": {
      "open_r_buffer": false
    },
    "full_config_rmd_inline_completion_tui.lua": {
      "open_r_buffer": false
    },
    "full_config_rmd_output_enter_after_leader_y_tui.lua": {
      "open_r_buffer": false
    },
    "full_config_runtime_extractor_tui.lua": {
      "open_r_buffer": false
    },
    "full_config_startup_keyword_completion_recovery_tui.lua": {
      "open_r_buffer": false
    },
    "full_config_subset_bracket_completion_tui.lua": {
      "open_r_buffer": false
    },
    "nvim_console_blink_tui.lua": {
      "open_r_buffer": false
    },
    "nvim_console_real_blink_value_completion_tui.lua": {
      "open_r_buffer": false
    },
    "nvim_console_signature_blink_tui.lua": {
      "open_r_buffer": false
    },
    "rmd_prose_space_escape_hides_menu_tui.lua": {
      "open_r_buffer": false
    },
    "startup_handoff_stays_stable_tui.lua": {
      "open_r_buffer": false
    },
    "home_directory_buffer_uses_scratch_workspace.lua": {
      "cwd": "HOME"
    }
  },
  "critical_journeys": {
    "release_install_and_discovery": "release_manifest_and_discovery.lua",
    "detached_static_language_features": "detached_parity.lua",
    "live_completion": "current_env_completion_timing.lua",
    "managed_tmux_session": "nvim_console_smoke.lua",
    "terminal_backend": "terminal_backend_live.lua",
    "arkhelp": "ark_help_end_to_end.lua",
    "arkview": "ark_view_live.lua",
    "targets": "targets_tmux_live.lua",
    "visible_blink_completion": "full_config_startup_completion.lua"
  }
}
